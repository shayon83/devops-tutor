# ==============================================================================
# DEVOPS VOICE TUTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All configuration secrets must be set in your local .env file.
# No hardcoded keys are present in source code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVEKIT SERVER & SFU CREDENTIALS (REQUIRED FOR ALL MODES)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. ORTHOGONAL AGENT & DISPATCH CONFIGURATION
# ------------------------------------------------------------------------------
# Setting 2A: Agent Worker Dispatch & Inference Type ('cloud' or 'local')
#   'cloud' : LiveKit Managed Inference Gateway (Zero 3rd-party API keys needed; model calls route via LiveKit Cloud)
#   'local' : Local Worker BYOK (Bring-Your-Own-Key: Requires OPENAI_API_KEY, AZURE_OPENAI_API_KEY, etc.) [DEFAULT]
AGENT_DISPATCH_TYPE=cloud

# Setting 2B: Voice Pipeline Architecture Mode ('realtime' or 'modular')
#   'realtime' : Direct Speech-to-Speech (~350ms response latency)
#   'modular'  : Cascaded STT (Deepgram/Whisper) -> LLM (GPT-4o-mini/Gemma) -> TTS (ElevenLabs/OpenAI)
VOICE_PIPELINE_MODE=realtime

# ------------------------------------------------------------------------------
# 3. BRING YOUR OWN KEYS (BYOK) - ONLY REQUIRED WHEN 'AGENT_DISPATCH_TYPE=local'
# ------------------------------------------------------------------------------
# Option 3A: Standard OpenAI API Key (Realtime & Modular STT/LLM/TTS)
OPENAI_API_KEY=your_openai_api_key

# Option 3B: Microsoft Azure AI Foundry / Azure OpenAI Realtime Model
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_foundry_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini-realtime-preview
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Option 3C: Modular Pipeline Provider Keys
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 4. INFRASTRUCTURE & SERVICE PORTS
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
