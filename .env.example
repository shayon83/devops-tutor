# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Provider Keys - Standard OpenAI or Microsoft Azure Foundry
OPENAI_API_KEY=your_openai_api_key

# (Optional) Azure OpenAI / Microsoft AI Foundry Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_foundry_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini-realtime-preview
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Optional Modular Provider Keys ('VOICE_PIPELINE_MODE=modular')
GEMINI_API_KEY=your_gemini_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Voice Pipeline Strategy Configuration ('realtime' or 'modular')
VOICE_PIPELINE_MODE=realtime

# Session Store & API Configuration
REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
