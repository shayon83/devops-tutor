# ==============================================================================
# DEVOPS VOICE TUTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All configuration secrets must be set in your local .env file.
# No hardcoded keys are present in source code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVEKIT SERVER & SFU CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Model inference (STT, LLM, TTS) is managed directly via LiveKit Cloud Managed Inference.
# Zero third-party AI provider API keys are needed!
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE & SERVICE PORTS
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
