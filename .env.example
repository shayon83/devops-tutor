# ==============================================================================
# DevOps Voice Tutor - environment template
# ==============================================================================
# cp .env.example .env, fill in the LiveKit values, then `docker compose up --build`.
# Every variable the code reads appears here; nothing is hardcoded in source.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Cloud (REQUIRED - the backend refuses to start without these)
# ------------------------------------------------------------------------------
# Free project at https://cloud.livekit.io. STT, LLM and TTS all run through
# LiveKit Inference, so no third-party model provider keys are needed.
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. Models (LiveKit Inference model IDs -- https://docs.livekit.io/agents/models/)
# ------------------------------------------------------------------------------
STT_MODEL=deepgram/flux-general-en
LLM_MODEL=openai/gpt-4o-mini
TTS_MODEL=cartesia/sonic-3

# ------------------------------------------------------------------------------
# 3. Redis conversation store
# ------------------------------------------------------------------------------
# Compose overrides REDIS_HOST to the `redis` service; `localhost` is for
# running the backend or agent outside Docker.
REDIS_HOST=redis
REDIS_PORT=6379
# How long a session's metadata, history and feedback live (seconds).
SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. Service ports and origins
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Origin(s) the backend accepts browser requests from (comma-separated).
# Must match where the SPA is served; update together with FRONTEND_PORT.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Backend origin baked into the SPA at build time (Vite inlines VITE_*).
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. Grafana
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=changeme
