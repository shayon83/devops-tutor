# ==============================================================================
# DEVOPS VOICE TUTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All configuration secrets must be set in your local .env file.
# No hardcoded keys are present in source code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVEKIT SERVER & SFU CREDENTIALS (REQUIRED FOR ALL MODES)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. VOICE PIPELINE MODE SELECTION
# ------------------------------------------------------------------------------
# Options:
#   'realtime'        : Direct Speech-to-Speech (Azure OpenAI or Standard OpenAI) [RECOMMENDED]
#   'livekit_managed' : LiveKit Cloud Managed Inference Provider
#   'modular'         : Classic STT (Deepgram) -> LLM (GPT-4o-mini) -> TTS (ElevenLabs)
VOICE_PIPELINE_MODE=realtime

# ------------------------------------------------------------------------------
# 3. AI PROVIDER KEYS - MODE A: DIRECT SPEECH-TO-SPEECH ('VOICE_PIPELINE_MODE=realtime')
# ------------------------------------------------------------------------------
# Option A1: Standard OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# Option A2: Microsoft Azure AI Foundry / Azure OpenAI (Overriding standard OpenAI)
# If AZURE_OPENAI_ENDPOINT & AZURE_OPENAI_API_KEY are provided, Azure AI Foundry is used automatically.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_foundry_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini-realtime-preview
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ------------------------------------------------------------------------------
# 4. AI PROVIDER KEYS - MODE B: MODULAR PIPELINE ('VOICE_PIPELINE_MODE=modular')
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 5. INFRASTRUCTURE & SERVICE PORTS
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
